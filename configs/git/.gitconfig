[user]
    name = vmphase
    email = vmphase.dev@gmail.com
    signingkey = ~/.ssh/id_ed25519_gh_signing.pub

[core]
    autocrlf = True
    editor = nano
    longpaths = true

[gpg]
	format = ssh

[gpg "ssh"]
	allowedSignersFile = ~/.ssh/allowed_signers

[commit]
	gpgsign = true

[diff]
    algorithm = histogram

[push]
    autoSetupRemote = true

[fetch]
    prune = True

[log]
    date = iso

[color]
    ui = auto

[alias]
    undo-commit = reset --soft HEAD~1
    visual-log = log --oneline --graph --decorate --all
    commit-empty = commit --allow-empty -m "empty commit"
    aliases = config --get-regexp ^alias\\.
